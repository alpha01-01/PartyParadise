# Production settings for docker-compose.prod.yml
#
#   cp .env.production.example .env.production
#
# Keep .env.production off git and do not reuse development values.
# Generate each secret with: openssl rand -hex 32

POSTGRES_PASSWORD=
SECRET_KEY=
INTERNAL_WEBHOOK_SECRET=

# Public addresses, both on HTTPS
WEB_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# Printed on invoices and contracts
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=

# Email: invites, password resets, invoices and contract links
SENDGRID_API_KEY=

# Leave empty during the staff beta. Online payments stay off without it.
PAYSTACK_SECRET_KEY=
