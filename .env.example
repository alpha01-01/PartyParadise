# ─────────────────────────────────────────────────────────────
# PartyParadise — Environment Variables
# Copy this file to .env and fill in your values.
#
# API:  copy to  api/.env
# Web:  copy to  web/.env.local
# ─────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════
# API  (api/.env)
# ═══════════════════════════════════════════════════════════════

# App
ENV=development                         # development | production
# Required. The API refuses to start with this placeholder: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — get this from your Supabase project settings
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your-database-password@localhost:5432/partyparadise

# Password for the Docker Compose database (required by docker compose)
POSTGRES_PASSWORD=your-database-password

# CORS — comma-separated list of allowed origins
# Development: localhost:3000
# Production: your actual domain
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Supabase Storage — for receipt uploads, contract PDFs, documents
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Paystack — Ghana payment gateway
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
# Use TEST keys for development, LIVE keys for production
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYSTACK_API_URL=https://api.paystack.co

# Shared secret between the Next.js webhook relay and the API.
# Must be set to the same value for both. Payments are rejected while empty.
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=

# SendGrid — for email delivery (invoices, contracts, notifications)
# Get from: sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@partyparadise.com
SENDGRID_FROM_NAME=PartyParadise

# Business info — used in PDF and email templates
BUSINESS_NAME=PartyParadise
BUSINESS_PHONE=+233 XX XXX XXXX
BUSINESS_EMAIL=hello@partyparadise.com
BUSINESS_ADDRESS=Accra, Ghana
WEB_URL=http://localhost:3000


# ═══════════════════════════════════════════════════════════════
# WEB  (web/.env.local)
# ═══════════════════════════════════════════════════════════════

# URL of your FastAPI backend
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Paystack public key (safe to expose — used for frontend Paystack.js)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL (used in sharing links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
